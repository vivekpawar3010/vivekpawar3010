# ==============================================================================
# 🌟 VIVEK PAWAR PORTFOLIO & KING SANCTUARY - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' (or '.env') in the project root:
#    cp .env.example .env.local
# 2. Fill in the values below with your personal keys and credentials.
# 3. DO NOT commit your real '.env' or '.env.local' to public Git repositories!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM + PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string.
# Supports local PostgreSQL, Supabase, Neon, Railway, or AWS RDS.
# If PostgreSQL is not configured, the app automatically falls back to
# local JSON dual-storage in src/data/ without crashing.
DATABASE_URL="postgresql://postgres:password@localhost:5432/vivekpawar_portfolio?schema=public"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Habit Streaks Sunday AI Evaluation)
# ------------------------------------------------------------------------------
# Used by the Sunday Habit Streaks Engine in King Admin to evaluate weekly consistency,
# score habit logs (0-100), assign letter grades (S, A+, A, B, C), and provide AI coaching reviews.
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If absent, the application gracefully uses an intelligent local heuristic AI coach fallback.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 3. GITHUB INTEGRATION (Live Profile & GraphQL Analytics)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Classic or Fine-Grained).
# Required for fetching live GitHub contribution heatmaps, commit logs, and repository stats.
# Create a classic token with 'read:user' and 'repo' permissions at:
# https://github.com/settings/tokens
GITHUB_PAT="ghp_yourPersonalAccessTokenHere"

# ------------------------------------------------------------------------------
# 4. KING ADMIN ACCESS CONTROL (Private Administrative Deck)
# ------------------------------------------------------------------------------
# Secret administrative passcode used to unlock the /king private sanctuary.
# Default fallback if unset: "king2026"
KING_PASSWORD="king2026"

# ------------------------------------------------------------------------------
# 5. APPLICATION URL (Base Host)
# ------------------------------------------------------------------------------
# Public base URL for canonical tags, metadata, and local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. NODE ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: "development" | "production" | "test"
NODE_ENV="development"

